+// 2_10_10_10 pack: inputs are 3.0 + value * 2^-22 (w: 3.0 + value * 2^-22, 2 bits)
+inline uint32_t PPCPack2101010(float x, float y, float z, float w)
+{
+    auto q = [](float v, uint32_t lo, uint32_t hi, uint32_t mask) {
+        float flo, fhi;
+        memcpy(&flo, &lo, 4);
+        memcpy(&fhi, &hi, 4);
+        v = v < flo ? flo : (v > fhi ? fhi : v);
+        uint32_t b;
+        memcpy(&b, &v, 4);
+        return b & mask;
+    };
+    return q(x, 0x403FFE01, 0x404001FF, 0x3FF) | (q(y, 0x403FFE01, 0x404001FF, 0x3FF) << 10) |
+           (q(z, 0x403FFE01, 0x404001FF, 0x3FF) << 20) | (q(w, 0x40400000, 0x40400003, 3) << 30);
+}
