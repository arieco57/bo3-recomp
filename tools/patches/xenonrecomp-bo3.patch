+// IEEE half -> float (vupkd3d128 float16 unpacks)
+inline float PPCHalfToFloat(uint16_t h)
+{
+    uint32_t sign = uint32_t(h & 0x8000) << 16, exp = (h >> 10) & 0x1F, man = h & 0x3FF, bits;
+    if (exp == 0)
+    {
+        if (man == 0) bits = sign;
+        else
+        {
+            exp = 113;
+            while (!(man & 0x400)) { man <<= 1; exp--; }
+            bits = sign | (exp << 23) | ((man & 0x3FF) << 13);
+        }
+    }
+    else if (exp == 31) bits = sign | 0x7F800000 | (man << 13);
+    else bits = sign | ((exp + 112) << 23) | (man << 13);
+    float f;
+    memcpy(&f, &bits, 4);
+    return f;
+}
+
+// float -> Xenos half (vpkd3d128): no infinities, saturates to 0x7FFF, truncates the mantissa
+inline uint16_t PPCFloatToHalf(float f)
+{
+    uint32_t bits;
+    memcpy(&bits, &f, 4);
+    uint32_t sign = (bits >> 16) & 0x8000, a = bits & 0x7FFFFFFF;
+    float af;
+    memcpy(&af, &a, 4);
+    if (af != af || af > 65504.0f) return uint16_t(sign | 0x7FFF);
+    uint32_t exp = a >> 23, man = (a & 0x7FE000) >> 13;
+    if (exp > 0x70) return uint16_t(sign | (((exp - 0x70) << 10) + man));
+    uint32_t sh = 0x71 - exp;
+    return uint16_t(sign | (sh > 31 ? 0 : (0x400 + man) >> sh));
+}
