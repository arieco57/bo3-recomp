    return VK_SUCCESS;
 }
 
+VkResult
+tu_bo_init_userptr(struct tu_device *dev, struct tu_bo **bo,
+                   void *ptr, uint64_t size)
+{
+   if (!dev->instance->knl->bo_init_userptr)
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   VkResult result = dev->instance->knl->bo_init_userptr(dev, bo, ptr, size);
+   if (result != VK_SUCCESS)
+      return result;
+   if (!(*bo)->unique_id)
+      (*bo)->unique_id = (*bo)->gem_handle;
+   return VK_SUCCESS;
+}
