diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 8b51fa2..0e95c5d 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -402,6 +402,110 @@ kgsl_bo_init_dmabuf(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+/* Import CPU memory (VK_EXT_external_memory_host).  The pages stay normal
+ * cached CPU memory; with IO-coherency the GPU snoops the CPU caches.
+ */
+static VkResult
+kgsl_bo_init_userptr(struct tu_device *dev,
+                     struct tu_bo **out_bo,
+                     void *ptr, uint64_t size)
+{
+   const int fd = dev->physical_device->local_fd;
+   uint64_t try_flags[3] = {
+      KGSL_MEMFLAGS_IOCOHERENT | (KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT),
+      KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT,
+      0,
+   };
+   unsigned first = dev->physical_device->has_cached_coherent_memory ? 0 : 1;
+   uint32_t id = 0;
+   uint64_t gpuaddr = 0, bo_size = 0, flags = 0;
+   bool ok = false;
+
+   /* Newer kernels: GPUOBJ_IMPORT of a user address. */
+   for (unsigned i = first; i < 3 && !ok; i++) {
+      struct kgsl_gpuobj_import_useraddr import_addr = {
+         .virtaddr = (uintptr_t)ptr,
+      };
+      struct kgsl_gpuobj_import req = {
+         .priv = (uintptr_t)&import_addr,
+         .priv_len = sizeof(import_addr),
+         .flags = try_flags[i],
+         .type = KGSL_USER_MEM_TYPE_ADDR,
+      };
+      if (safe_ioctl(fd, IOCTL_KGSL_GPUOBJ_IMPORT, &req) == 0) {
+         struct kgsl_gpuobj_info info_req = { .id = req.id };
+         if (safe_ioctl(fd, IOCTL_KGSL_GPUOBJ_INFO, &info_req) == 0) {
+            id = req.id;
+            gpuaddr = info_req.gpuaddr;
+            bo_size = info_req.size;
+            flags = req.flags;
+            ok = true;
+         }
+      } else {
+         mesa_logw("kgsl: GPUOBJ_IMPORT userptr flags 0x%llx: %s",
+                   (unsigned long long)try_flags[i], strerror(errno));
+      }
+   }
+
+   /* Older kernels (4.14): GPUOBJ_IMPORT passes size 0 to the anonymous
+    * memory path, which only MAP_USER_MEM fills in.
+    */
+   for (unsigned i = first; i < 3 && !ok; i++) {
+      struct kgsl_map_user_mem req = {
+         .fd = -1,
+         .len = (size_t)size,
+         .offset = 0,
+         .hostptr = (unsigned long)(uintptr_t)ptr,
+         .memtype = KGSL_USER_MEM_TYPE_ADDR,
+         .flags = (unsigned int)try_flags[i],
+      };
+      if (safe_ioctl(fd, IOCTL_KGSL_MAP_USER_MEM, &req) == 0) {
+         struct kgsl_gpumem_get_info info_req = { .gpuaddr = req.gpuaddr };
+         if (safe_ioctl(fd, IOCTL_KGSL_GPUMEM_GET_INFO, &info_req) == 0) {
+            id = info_req.id;
+            gpuaddr = req.gpuaddr;
+            bo_size = info_req.size;
+            flags = info_req.flags;
+            ok = true;
+         } else {
+            mesa_logw("kgsl: GPUMEM_GET_INFO: %s", strerror(errno));
+         }
+      } else {
+         mesa_logw("kgsl: MAP_USER_MEM flags 0x%llx: %s",
+                   (unsigned long long)try_flags[i], strerror(errno));
+      }
+   }
+
+   if (!ok)
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to import user memory\n");
+   mesa_logi("kgsl: imported %llu bytes of user memory at gpu 0x%llx, flags 0x%llx",
+             (unsigned long long)bo_size, (unsigned long long)gpuaddr,
+             (unsigned long long)flags);
+
+   struct tu_bo* bo = tu_device_lookup_bo(dev, id);
+   assert(bo && bo->gem_handle == 0);
+
+   *bo = (struct tu_bo) {
+      .gem_handle = id,
+      .size = bo_size,
+      .iova = gpuaddr,
+      .name = tu_debug_bos_add(dev, bo_size, "userptr"),
+      .refcnt = 1,
+      .shared_fd = -1,
+      .map = ptr,
+      .never_unmap = true,
+      .userptr = true,
+   };
+   bo->cached_non_coherent =
+      !(flags & KGSL_MEMFLAGS_IOCOHERENT) &&
+      dev->physical_device->has_cached_non_coherent_memory;
+
+   tu_dump_bo_init(dev, bo);
+   *out_bo = bo;
+   return VK_SUCCESS;
+}
+
